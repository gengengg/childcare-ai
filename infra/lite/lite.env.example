# 온퇴근 경량판 서버 설정
# 서버에서: cp infra/lite/lite.env.example infra/lite/.env 후 값 채우기 (GitHub에 올리지 마세요)

# ── 도메인 ──
APP_DOMAIN=ontoegeun.kr
AI_DOMAIN=ai.ontoegeun.kr

# ── Supabase (지금 쓰는 클라우드 프로젝트) ──
SUPABASE_URL=https://acaliievkxwooefgwrda.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# 카카오 로그인 버튼 표시 (Supabase에서 Kakao Provider를 켠 뒤 true)
KAKAO_ENABLED=false

# ── 매일 DB 백업용 접속 주소 (선택이지만 강력 추천) ──
# Supabase 대시보드 → Connect → Session pooler 주소 (비밀번호 포함)
SUPABASE_DB_URL=
