# ─────────────────────────────────────────────────────────────
# 온퇴근 서버 설정 — install.sh 가 이 값을 Supabase .env 끝에 붙인다.
# 서버에서: cp infra/ontoegeun.env.example infra/ontoegeun.env 후 값 채우기
# (ontoegeun.env 는 .gitignore 대상: 절대 GitHub에 올리지 마세요)
# ─────────────────────────────────────────────────────────────

# ── 도메인 (가비아 등에서 산 도메인) ──
# 앱 화면 주소
APP_DOMAIN=ontoegeun.kr
# Supabase API(로그인·DB·파일) 주소
PROXY_DOMAIN=api.ontoegeun.kr
# AI 서버 주소
AI_DOMAIN=ai.ontoegeun.kr

# ── 메일 발송 (회원가입 코드, 비밀번호 재설정) ──
# 원화 결제되는 메일 서비스의 SMTP 정보를 넣으세요.
SMTP_ADMIN_EMAIL=no-reply@ontoegeun.kr
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=온퇴근

# ── Google 로그인 (기존 Google Cloud OAuth 클라이언트 재사용 가능) ──
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ── 카카오 로그인 (Kakao Developers 앱) ──
# REST API 키 = CLIENT_ID, 보안 > Client Secret = SECRET
KAKAO_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_SECRET=
